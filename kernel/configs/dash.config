CONFIG_MIEV=m
CONFIG_XIAOMI_HWID=m
CONFIG_MTK_ULTRASND_PROXIMITY=m
CONFIG_MI_DISP_LHBM=y
CONFIG_MI_DISP_ESD_CHECK=y
CONFIG_MTK_MMPROFILE_DEBUG=y
CONFIG_MTK_DISP_LOGGER=y
CONFIG_DRM_PANEL_P10U_42_02_0A_DSC_VDO=m
CONFIG_DRM_PANEL_P10U_36_02_0B_DSC_VDO=m
CONFIG_MI_DISP_VDO_AOD=y
CONFIG_MI_DISP_DFS_EVENT=y
CONFIG_MI_HWCONF_MANAGER=y
CONFIG_XMEXT_TI_GAUGE=m
CONFIG_XIAOMI_FINGERPRINT_SPI_NUM=3
CONFIG_INTR2_PIN_ENABLE=1
CONFIG_XIAOMI_FINGERPRINT=m
# CONFIG_MI_UNION_POWER is not set
CONFIG_MIHW=y
CONFIG_MI_POWER_SAVE=m
CONFIG_SIH_VIBRATOR=m
#skynet add
CONFIG_MI_CAMLOG=m
#audio-vow add
CONFIG_MTK_VOW_SUPPORT=m
CONFIG_MTK_VOW_BARGE_IN_SUPPORT=y
CONFIG_MTK_VOW_DUAL_MIC_SUPPORT=y
CONFIG_MTK_VOW_MAX_PDK_NUMBER=1
CONFIG_MTK_VOW_AMAZON_SUPPORT=n
CONFIG_MTK_VOW_GVA_SUPPORT=n
CONFIG_MTK_VOW_PCMCALLBACK_SUPPORT=n
CONFIG_MTK_VOW_DSP_VERSION="ver02"
CONFIG_MITEE_SUPPORT=m
CONFIG_LEDS_AWRGB21024=m
CONFIG_NXP_P73_DEVICES=m
CONFIG_NFC_NXP_I2C=m
CONFIG_XMEXT_SC858X_CHG_PUMP=m
CONFIG_XMEXT_SC8585_CHG_PUMP=m
CONFIG_HL7603_BOOST=m
CONFIG_RUST_DETECTION=y
CONFIG_XM_SOH_SN=y
CONFIG_CHARGER_BQ25985=m
CONFIG_XM_SINGLE_PD_MANAGER=m
CONFIG_MTK_UT_TEST=m
CONFIG_REGULATOR_WL2866D=m
CONFIG_REGULATOR_SGM38121=m
CONFIG_SND_SMARTPA_AW882XX=m
CONFIG_SND_SOC_FRSM=m
CONFIG_SND_SOC_TFA9874=n
CONFIG_USB_SWITCH_ET7480=m
# Stock platform ramdisk carries this MTD module set. Keep it modular so the
# matching first-stage modules can be built from the ACK tree.
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_OOPS=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OF_PARTS=m

# Xiaomi memory diagnostics.
# CONFIG_XIAOMI_MI_STACK is not set
# CONFIG_XIAOMI_MI_UBT is not set
# CONFIG_XIAOMI_MI_UBT_TEST is not set
# CONFIG_XIAOMI_CRASH_MODULE is not set
CONFIG_XIAOMI_MI_MEMORY=m
#mi_memory
CONFIG_XIAOMI_DEBUG_EXT=m
CONFIG_CAM_INTENTAWARE_FSYS=m
CONFIG_INPUT_FS3002_HAPTIC=m

CONFIG_MEMCG=y
# END Performance_BoostFramework
#Sensor add
CONFIG_MTK_TINYSYS_SCP_DEBUG_SUPPORT=y

#camera add
CONFIG_CUSTOM_KERNEL_IMGSENSOR="dashscx6000wide_mipi_raw dashov20bfront_mipi_raw dashsc821csultra_mipi_raw"
CONFIG_BUILD_XIAOMI_CAMERA_IMAGE_NAMES="dash"
# dio_dma_mapper is in the vendor_dlkm load list.
CONFIG_DEVICE_MODULES_DIO_DMABUF_MAPPER=m

#Modem add
# CONFIG_MI_T1_CHIP is not set
# CONFIG_SIMTRAY_STATUS is not set

#Performance add
# CONFIG_BINDER_PRIO is not set
# CONFIG_XIAOMI_PERF_HELPER is not set
CONFIG_XIAOMI_PERF_ACTUATOR=m
CONFIG_XIAOMI_MIICMPFILTER=m
# CONFIG_XIAOMI_MILLET_CORE is not set
# CONFIG_XIAOMI_MILLET_HS is not set
# CONFIG_XIAOMI_MILLET_SIG is not set
# CONFIG_XIAOMI_MILLET_PKG is not set
# CONFIG_XIAOMI_BINDER_GKI is not set
# CONFIG_XIAOMI_MILLET_BINDER is not set
CONFIG_XIAOMI_XM_POWER=m
# CONFIG_XIAOMI_MI_MEM_EPOLL is not set
# CONFIG_XIAOMI_SLA is not set
# CONFIG_MINET is not set
# CONFIG_XIAOMI_MI_MEMPOOL is not set
# Shipped in the stock vendor_dlkm, build them from source.
CONFIG_XIAOMI_IO_MONITOR=m
CONFIG_XIAOMI_LB=m
# patches kernel/sched/sched.h internals, does not build on 6.6
# CONFIG_XIAOMI_MI_SCHEDULE is not set
CONFIG_XIAOMI_XR_QI=m
# same sched.h internals as mi_schedule
# CONFIG_XIAOMI_XR_QS is not set
# CONFIG_XIAOMI_MIWiLL is not set
# CONFIG_XIAOMI_MIWiLL_REDUDANCY is not set
CONFIG_XIAOMI_METIS=m
# CONFIG_XIAOMI_MIGT is not set

#Touch add
CONFIG_BUILD_PRODUCT_NAME="dash"
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_COMMON=m
CONFIG_TOUCHSCREEN_NT38771=m
#Thermal add
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=y
CONFIG_MI_THERMAL_ATC_ENABLE=y

# FCM requires CONFIG_AIO; android-recommended.config turns it off.
CONFIG_AIO=y
# GKI symbol protection must stay off: this build signs no modules.
# CONFIG_MODULE_SIG_PROTECT is not set
# Stock does not reboot on panic.
CONFIG_PANIC_TIMEOUT=-1
# Stock and the kleaf build run with hardware AFDBM on.
CONFIG_ARM64_HW_AFDBM=y
# Stock does not run same page merging.
# CONFIG_KSM is not set
# TLS is in the system_dlkm load list.
CONFIG_TLS=m
# The Xiaomi display framework gates the lcm struct and the DSI panel
# helpers the panel modules need; keep it on explicitly.
CONFIG_MI_DISP=y
# The stock kernel is built without LTO; the GKI defconfig enables
# ThinLTO + AutoFDO and the LTO'd kernel never gets past the logo.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG is not set
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_AUTOFDO_CLANG is not set
# frs and mi_schedule do not build against this tree; the kernel works
# without them. Zram and zsmalloc serve the ramdisk swap.
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=m

# Device APC: only the MT6991 driver is valid on this platform. Every
# other SoC variant, and the legacy ARCH_COMMON implementation, exports
# the same register_devapc_vio_callback symbol as device-apc-common.
# depmod then picks one of those variants as the provider for unrelated
# modules, loading it next to device-apc-common fails with "exports
# duplicate symbol", and modprobe aborts the entire dependent chain
# (thermal_interface, ged, mtk_gpu_pdma, mali_kbase and more).
CONFIG_DEVAPC_ARCH_MULTI=m
# CONFIG_DEVAPC_ARCH_COMMON is not set
# CONFIG_DEVAPC_MT6761 is not set
# CONFIG_DEVAPC_MT6765 is not set
# CONFIG_DEVAPC_MT6768 is not set
# CONFIG_DEVAPC_MT6781 is not set
# CONFIG_DEVAPC_MT6833 is not set
# CONFIG_DEVAPC_MT6853 is not set
# CONFIG_DEVAPC_MT6873 is not set
# CONFIG_DEVAPC_MT6877 is not set
# CONFIG_DEVAPC_MT6879 is not set
# CONFIG_DEVAPC_MT6886 is not set
# CONFIG_DEVAPC_MT6893 is not set
# CONFIG_DEVAPC_MT6895 is not set
# CONFIG_DEVAPC_MT6897 is not set
# CONFIG_DEVAPC_MT6899 is not set
# CONFIG_DEVAPC_MT6983 is not set
# CONFIG_DEVAPC_MT6985 is not set
# CONFIG_DEVAPC_MT6989 is not set

# The MDP dummy is for platforms without a real MDP driver. It exports
# mdp_dpc_register, which mdp_drv_mt6991 also exports, so building both
# makes depmod pick the dummy as the provider and the real driver (and
# the mtk_dpc display chain) fails to load. Dash has the real MT6991
# driver; do not build the dummy.
# CONFIG_MTK_MDP_DUMMY is not set
# Select the real MDP driver explicitly instead of depending on
# CONFIG_MTK_MDP being m (the old Makefile only built mt6991 in its
# else branch, so a y config silently built the wrong drivers).
CONFIG_MTK_MDP_MT6991=m

# The generic VMM notifier duplicates the MT6991 variant at runtime, but
# mtk_aov links against vmm_isp_ctrl_notify at modpost time, so it has to
# stay built. Its runtime duplicate failure is harmless: nothing in the
# display chain depends on it.
CONFIG_MTK_VMM_NOTIFIER=m

# c2k_usb (CDMA USB) and usb_offload are not used on dash. When they
# load, they reconfigure the USB gadget and adb never enumerates.
# CONFIG_MTK_ECCCI_C2K_USB is not set
# CONFIG_MTK_USB_OFFLOAD is not set
# RNDIS selects mtk_u_ether/mtk_usb_f_rndis, which also steal the UDC.
# CONFIG_MTK_USB_CONFIGFS_RNDIS is not set
